  },
  "bugs": {
    "url": "https://github.com/KageRyo/diff/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "diff": "9.0.0"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
